{
  "name": "@keyra/engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test:e2e": "pnpm --dir tests/e2e test:e2e",
    "test:e2e:parity": "pnpm --dir tests/e2e test:e2e:parity",
    "test:e2e:local": "pnpm --dir tests/e2e test:e2e:local",
    "test:e2e:backend": "pnpm --dir tests/e2e test:e2e:backend",
    "test:e2e:list": "pnpm --dir tests/e2e test:e2e:list",
    "build:auto-map": "npx esbuild src/lambda/ai/auto-map.ts --bundle --platform=node --target=node20 --format=cjs --outfile=build/auto-map/index.cjs",
    "zip:auto-map": "sh -c 'cd build/auto-map && rm -f function.zip && zip -q -r function.zip index.cjs'",
    "package:auto-map": "pnpm run build:auto-map && pnpm run zip:auto-map",
    "engine:run": "tsx scripts/run-engine.ts",
    "explain-rule:run": "tsx scripts/run-explain-rule.ts",
    "auto-map:run": "tsx scripts/run-auto-map.ts",
    "suggest-expression:run": "tsx scripts/run-suggest-expression.ts",
    "test:integration": "RUN_DYNAMODB_LOCAL_INTEGRATION=1 vitest run --passWithNoTests tests/lambda/integration",
    "test:integration:persistence": "RUN_PERSISTENCE_INTEGRATION=1 vitest run --passWithNoTests tests/integration/persistence",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.922.0",
    "@aws-sdk/client-s3": "^3.922.0",
    "@aws-sdk/client-sfn": "^3.1047.0",
    "@aws-sdk/credential-provider-node": "^3.972.41",
    "@aws-sdk/lib-dynamodb": "^3.922.0",
    "@opensearch-project/opensearch": "^3.6.0",
    "fast-xml-parser": "^5.8.0",
    "openai": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "eslint": "^9.26.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.1",
    "vitest": "^3.1.2"
  }
}
