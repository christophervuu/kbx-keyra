# AWS Region
AWS_REGION=us-east-1

# Stage
STAGE=dev

# DynamoDB Tables
PROJECTS_TABLE=dev-keyra-projects
MAPPINGS_TABLE=dev-keyra-mappings
SCHEMA_METADATA_TABLE=dev-keyra-schema-metadata
SCHEMA_NODES_TABLE=dev-keyra-schema-nodes
MAPPING_REVISIONS_TABLE=dev-keyra-mapping-revisions
MAPPING_VERSIONS_TABLE=dev-keyra-mapping-versions
DEPLOYMENTS_TABLE=dev-keyra-deployments
DEPLOYMENT_CURRENT_TABLE=dev-keyra-deployment-current

# Compatibility aliases used by current handlers
SCHEMAS_TABLE=dev-keyra-schema-metadata

# S3
STORAGE_BUCKET=dev-keyra-storage-local

# Compatibility aliases used by current handlers
CONTENT_BUCKET=dev-keyra-storage-local
SCHEMA_BUCKET=dev-keyra-storage-local

# Endpoint overrides (local development)
DYNAMODB_ENDPOINT=http://localhost:8000
S3_ENDPOINT=http://localhost:4566

# OpenSearch (not emulated locally — use mock in tests)
OPENSEARCH_ENDPOINT=

# Step Functions
STATE_MACHINE_ARN=
INGESTION_STATE_MACHINE_ARN=
