{
  "Comment": "Schema ingestion orchestration for large schemas (parse, batch process, aggregate, metadata update, error handling)",
  "StartAt": "ParseSchema",
  "TimeoutSeconds": 900,
  "States": {
    "ParseSchema": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${OrchestrationTasksFunctionArn}",
        "Payload": {
          "action": "parse",
          "schemaId.$": "$.schemaId",
          "s3Key.$": "$.s3Key",
          "format.$": "$.format",
          "storageBucket": "${StorageBucket}"
        }
      },
      "ResultSelector": {
        "batchReferences.$": "$.Payload.batchReferences",
        "fieldCount.$": "$.Payload.fieldCount",
        "processedContentS3Key.$": "$.Payload.processedContentS3Key"
      },
      "ResultPath": "$.parse",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "HandleError"
        }
      ],
      "Next": "ProcessBatches"
    },
    "ProcessBatches": {
      "Type": "Map",
      "ItemsPath": "$.parse.batchReferences",
      "MaxConcurrency": 10,
      "ItemSelector": {
        "schemaId.$": "$.schemaId",
        "batch.$": "$$.Map.Item.Value"
      },
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "ProcessBatch",
        "States": {
          "ProcessBatch": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${ProcessBatchFunctionArn}",
              "Payload": {
                "schemaId.$": "$.schemaId",
                "batch.$": "$.batch"
              }
            },
            "ResultSelector": {
              "batchIndex.$": "$.Payload.batchIndex",
              "nodesWritten.$": "$.Payload.nodesWritten",
              "nodesIndexed.$": "$.Payload.nodesIndexed",
              "errors.$": "$.Payload.errors"
            },
            "End": true
          }
        }
      },
      "ResultPath": "$.batchResults",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "HandleError"
        }
      ],
      "Next": "AggregateResults"
    },
    "AggregateResults": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${OrchestrationTasksFunctionArn}",
        "Payload": {
          "action": "aggregate",
          "schemaId.$": "$.schemaId",
          "fieldCount.$": "$.parse.fieldCount",
          "processedContentS3Key.$": "$.parse.processedContentS3Key",
          "batchResults.$": "$.batchResults"
        }
      },
      "ResultSelector": {
        "schemaId.$": "$.Payload.schemaId",
        "fieldCount.$": "$.Payload.fieldCount",
        "written.$": "$.Payload.written",
        "indexed.$": "$.Payload.indexed",
        "failed.$": "$.Payload.failed"
      },
      "ResultPath": "$.aggregate",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "HandleError"
        }
      ],
      "Next": "UpdateMetadata"
    },
    "UpdateMetadata": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${OrchestrationTasksFunctionArn}",
        "Payload": {
          "action": "updateMetadata",
          "schemaId.$": "$.schemaId",
          "status": "ready",
          "fieldCount.$": "$.aggregate.fieldCount"
        }
      },
      "ResultPath": "$.metadata",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "HandleError"
        }
      ],
      "End": true
    },
    "HandleError": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${OrchestrationTasksFunctionArn}",
        "Payload": {
          "action": "handleError",
          "schemaId.$": "$.schemaId",
          "status": "error",
          "error.$": "$.error"
        }
      },
      "End": true
    }
  }
}
